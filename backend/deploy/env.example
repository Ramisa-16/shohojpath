# Production environment for PythonAnywhere.
#
# Copy to backend/.env ON THE SERVER — never commit the real file, it holds
# the signing key for every token the app issues.
#
#   cp deploy/env.example .env && nano .env
#
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

SECRET_KEY=replace-me-with-a-freshly-generated-key
DEBUG=False

# Required on a real host. `manage.py check --deploy` fails without it, which
# is what the update script relies on to stop a deploy that would serve
# children's data over plain HTTP.
SECURE_SSL_REDIRECT=True

# Your PythonAnywhere host, no scheme, no trailing slash.
ALLOWED_HOSTS=USERNAME.pythonanywhere.com

# The Flutter app is not a browser origin, so CORS stays closed. These two
# only matter for the Django admin.
CORS_ALLOW_ALL=False
CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com

# Keep the database outside the repository, so a `git pull` or a re-clone can
# never stand between you and the study data. Note the four slashes: three for
# the sqlite:// scheme plus the leading / of an absolute path.
DATABASE_URL=sqlite:////home/USERNAME/shohojpath-data/db.sqlite3

TIME_ZONE=Asia/Dhaka
