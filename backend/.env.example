# Copy to .env for local development. Never commit the real .env.
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Dhaka

# Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOW_ALL=True
# CORS_ALLOWED_ORIGINS=https://your-admin-domain
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=90
