# LOCAL DEVELOPMENT ONLY. Copy to .env. Never commit the real .env.
#
# Do not put this on a server: DEBUG=True, ALLOWED_HOSTS=* and a SECRET_KEY
# that is published in this repository. For a real host use
# deploy/env.example — see deploy/PYTHONANYWHERE.md.
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Dhaka

# Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOW_ALL=True
# CORS_ALLOWED_ORIGINS=https://your-admin-domain
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=90
